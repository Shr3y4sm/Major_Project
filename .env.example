# --- Server ---
# Bind address / port for `python app.py`.
# Hospitals: keep the default (localhost-only). Set APP_HOST=0.0.0.0 only
# behind a reverse proxy / VPN; never expose PHI-capable uploads directly.
APP_HOST=127.0.0.1
APP_PORT=7860

# BraTS-ifier standardization pipeline (affine 1mm resample + N4 + rigid
# registration + BraTS canvas). Disable (=0) only for debugging; the trained
# model expects BraTS-grade input.
BRATSIFY=1

# Slice-viewer defaults (axial, sagittal, coronal).
DEFAULT_AXIAL_IDX=78
DEFAULT_SAGITTAL_IDX=120
DEFAULT_CORONAL_IDX=120

# Retain per-run workdirs under the system temp dir for audit (hours).
# 0 = delete immediately after the run (most private). Empty = keep for debug.
ARTIFACT_RETENTION_HOURS=24

# --- Deployment ---
# Path to the ONNX model inside the container / host.
# ONNX_PATH=artifacts/best_unet.onnx
# Set to 1 when running behind HTTPS proxy with trusted certs.
# GRADIO_SHARE=0
